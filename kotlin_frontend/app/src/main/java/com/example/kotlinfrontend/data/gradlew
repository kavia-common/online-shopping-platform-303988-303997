#!/usr/bin/env bash
set -euo pipefail

# CI fallback for -w kotlin_frontend/app/src/main/java/com/example/kotlinfrontend/data
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_GRADLEW="$(cd "${SCRIPT_DIR}/../../../../../../../.." && pwd)/gradlew"

if [[ ! -x "${REAL_GRADLEW}" ]]; then
  echo "Error: Expected Gradle wrapper at ${REAL_GRADLEW} but it was not found or not executable." >&2
  exit 127
fi

exec "${REAL_GRADLEW}" "$@"

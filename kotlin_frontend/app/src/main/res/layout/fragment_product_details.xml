<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/product_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/details_panel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_rounded"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Media gallery (mock): horizontally swipeable placeholders. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_gallery"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:contentDescription="@string/cd_product_gallery" />

            <!-- Indicators (shown when imageUrls.size > 1). -->
            <LinearLayout
                android:id="@+id/gallery_dots"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/dot_1"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_pager_dot_selected" />

                <View
                    android:id="@+id/dot_2"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pager_dot" />

                <View
                    android:id="@+id/dot_3"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pager_dot" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/title_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tv_name"
                    style="@style/TextAppearance.Ocean.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/btn_favorite" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/cd_add_to_favorites"
                    android:importantForAccessibility="yes"
                    android:padding="12dp"
                    android:src="@drawable/ic_heart_outline"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_category"
                style="@style/TextAppearance.Ocean.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <!-- Sale badge + pricing -->
            <TextView
                android:id="@+id/tv_sale_badge"
                style="@style/TextAppearance.Ocean.Badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_sale_badge"
                android:text="@string/sale_badge"
                android:visibility="gone"
                android:contentDescription="@string/cd_sale_badge" />

            <LinearLayout
                android:id="@+id/price_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_sale_price"
                    style="@style/TextAppearance.Ocean.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tv_price"
                    style="@style/TextAppearance.Ocean.Price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00" />

                <TextView
                    android:id="@+id/tv_original_price"
                    style="@style/TextAppearance.Ocean.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="$0.00"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Rich description -->
            <TextView
                android:id="@+id/tv_description"
                style="@style/TextAppearance.Ocean.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:lineSpacingExtra="2dp" />

            <!-- Specs / bullet points -->
            <TextView
                android:id="@+id/tv_specs_title"
                style="@style/TextAppearance.Ocean.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/specs_title"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_specs"
                style="@style/TextAppearance.Ocean.Muted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_to_cart"
                style="@style/Widget.Ocean.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/add_to_cart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_go_to_cart"
                style="@style/Widget.Ocean.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/go_to_cart" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

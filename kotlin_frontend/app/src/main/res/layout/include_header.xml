<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/toolbar"
    android:layout_width="match_parent"
    android:layout_height="?attr/actionBarSize"
    android:background="@color/ocean_surface"
    android:elevation="4dp"
    app:title="@string/app_name"
    app:titleTextAppearance="@style/TextAppearance.Ocean.ToolbarTitle"
    app:subtitleTextAppearance="@style/TextAppearance.Ocean.ToolbarSubtitle"
    app:titleTextColor="@color/ocean_text"
    app:subtitleTextColor="@color/ocean_muted_text" />

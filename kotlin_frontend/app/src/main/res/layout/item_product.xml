<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_surface_rounded"
    android:minHeight="72dp"
    android:padding="16dp">

    <!-- Placeholder image; kept as View for mock data UI. -->
    <View
        android:id="@+id/product_image_placeholder"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_chip_outline"
        android:contentDescription="@string/title_product_details"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_name"
        style="@style/TextAppearance.Ocean.Subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="2"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toTopOf="@id/product_image_placeholder"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_meta"
        style="@style/TextAppearance.Ocean.Caption"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_price"
        style="@style/TextAppearance.Ocean.Price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/tv_meta" />

</androidx.constraintlayout.widget.ConstraintLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_surface_rounded"
    android:padding="12dp">

    <View
        android:id="@+id/product_image_placeholder"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/bg_chip_outline"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tv_name"
        style="@style/TextAppearance.Ocean.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toTopOf="@id/product_image_placeholder"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_meta"
        style="@style/TextAppearance.Ocean.Muted"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/tv_name"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tv_price"
        style="@style/TextAppearance.Ocean.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toEndOf="@id/product_image_placeholder"
        app:layout_constraintTop_toBottomOf="@id/tv_meta" />

</androidx.constraintlayout.widget.ConstraintLayout>

#!/usr/bin/env sh
# Failsafe wrapper shim. The real Gradle wrapper should exist in this same directory
# in normal checkouts; if it doesn't, attempt to call `gradle` directly.
#
# PUBLIC_INTERFACE
# CI entrypoint: if a proper Gradle wrapper jar/scripts are present, use them; otherwise fall back.

set -eu

DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
REAL="$DIR/gradlew.real"

# If someone has provided a real wrapper with a different name, prefer it.
if [ -f "$REAL" ]; then
  chmod +x "$REAL" 2>/dev/null || true
  exec "$REAL" "$@"
fi

# If the standard wrapper support files exist, this script is expected to be replaced by them.
# Fall back to system gradle (may not exist in CI image).
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi

echo "Error: No usable Gradle wrapper found and 'gradle' is not available on PATH." >&2
echo "Expected either:" >&2
echo "  - a real wrapper at $REAL, or" >&2
echo "  - system 'gradle' installed in the CI environment." >&2
exit 127

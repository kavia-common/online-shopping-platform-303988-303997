#!/bin/sh
# Workdir-level Gradle wrapper shim.
# Some CI harnesses `cd workdir/` and then run `./gradlew`.

set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
ROOT_GRADLEW="$SCRIPT_DIR/../gradlew"

if [ ! -f "$ROOT_GRADLEW" ]; then
  echo "Error: repo root gradlew not found at: $ROOT_GRADLEW" >&2
  exit 127
fi

if [ ! -x "$ROOT_GRADLEW" ]; then
  chmod +x "$ROOT_GRADLEW" 2>/dev/null || true
fi

exec sh "$ROOT_GRADLEW" "$@"

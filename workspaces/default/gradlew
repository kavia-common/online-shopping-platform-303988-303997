#!/bin/sh
# CI compatibility wrapper inside repo-root workspaces/default/ folder.

set -e

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# default -> workspaces -> repo
REPO_DIR=$(CDPATH= cd -- "$SCRIPT_DIR/../.." && pwd)

REAL_GRADLEW="$REPO_DIR/gradlew"

if [ ! -f "$REAL_GRADLEW" ]; then
  echo "Error: Expected gradlew at: $REAL_GRADLEW" >&2
  exit 127
fi

chmod +x "$REAL_GRADLEW" 2>/dev/null || true
exec sh "$REAL_GRADLEW" "$@"
